# Copy this file to .env and fill in what you have.
# Anything left blank runs in offline / simulated mode.

# ---- PayPal sandbox (developer.paypal.com > Apps & Credentials > Sandbox) ----
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# ---- AI (console.anthropic.com > API Keys) ----
ANTHROPIC_API_KEY=
# auto = live if you have a key, else offline. Also: offline, mock, live
AI_MODE=auto
FAST_MODEL=claude-haiku-5-5
JUDGE_MODEL=claude-sonnet-5-5
AI_TIMEOUT_S=15
MOCK_LATENCY_S=0.4

# ---- Prices in dollars per MILLION tokens (copy them from Anthropic's pricing page) ----
PRICE_FAST_IN=0
PRICE_FAST_OUT=0
PRICE_JUDGE_IN=0
PRICE_JUDGE_OUT=0

# ---- Speed and cost switches (true = the efficient design) ----
USE_CACHE=true
PARALLEL=true
SKIP_TRIAL_ON_RULE_FAIL=true
SHOPPER_USES_AI=false

PORT=3000
